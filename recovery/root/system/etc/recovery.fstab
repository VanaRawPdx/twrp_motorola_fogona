# Recovery fstab for Moto G Play 2024 (fogona).
# Dynamic partition filesystems were measured from this firmware's super image.
system          /system         erofs   ro   wait,slotselect,logical,first_stage_mount
system_ext      /system_ext     erofs   ro   wait,slotselect,logical,first_stage_mount
product         /product        erofs   ro   wait,slotselect,logical,first_stage_mount
vendor          /vendor         erofs   ro   wait,slotselect,logical,first_stage_mount
system_dlkm     /system_dlkm    erofs   ro   wait,slotselect,logical,first_stage_mount
vendor_dlkm     /vendor_dlkm    erofs   ro   wait,slotselect,logical,first_stage_mount

/dev/block/bootdevice/by-name/userdata     /data       f2fs   noatime,nosuid,nodev,discard,fsync_mode=nobarrier   wait,check,encryptable=footer
/dev/block/bootdevice/by-name/metadata     /metadata   f2fs   noatime,nosuid,nodev,discard                       wait,check,formattable,wrappedkey

/dev/block/bootdevice/by-name/boot          /boot          emmc   defaults   slotselect
/dev/block/bootdevice/by-name/init_boot     /init_boot     emmc   defaults   slotselect
/dev/block/bootdevice/by-name/vendor_boot   /vendor_boot   emmc   defaults   slotselect
/dev/block/bootdevice/by-name/recovery      /recovery      emmc   defaults   slotselect
/dev/block/bootdevice/by-name/dtbo          /dtbo          emmc   defaults   slotselect
/dev/block/bootdevice/by-name/vbmeta        /vbmeta        emmc   defaults   slotselect
/dev/block/bootdevice/by-name/vbmeta_system /vbmeta_system emmc   defaults   slotselect
/dev/block/bootdevice/by-name/super         /super         emmc   defaults   defaults
/dev/block/bootdevice/by-name/misc          /misc          emmc   defaults   defaults

/dev/block/bootdevice/by-name/persist      /persist       ext4   noatime,nosuid,nodev,data=ordered,barrier=1   wait
/dev/block/bootdevice/by-name/prodpersist  /prodpersist   ext4   noatime,nosuid,nodev,data=ordered,barrier=1   wait,nofail
/dev/block/mmcblk1p1                       /external_sd   vfat   nosuid,nodev                                 wait,nofail

